  m_Script: {fileID: 11500000, guid: 8d5f919a06554c24581b88551cb58fc1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::BossDialogue
  canvasGroup: {fileID: 869281547}
  dialogueText: {fileID: 963134933}
  dialogueLines:
  - '"So... a mere Wooper has braved the crushing depths and the howling winds to
    reach my domain?"'
  - '"I must admit, little one... your tenacity is commendable. Few of your kind
    possess such a spirited heart."'
  - '"You have traveled far, and for that, you have earned my temporary praise."'
  - '"However... the balance of these waters cannot be disturbed by one so small."'
  - '"Your journey ends here. It is time for you to vanish into the abyss."'
  - '"Begone, child of the tides!"'
  boss: {fileID: 2055837775132645232, guid: 0b4ab33df06cd0f4a910c4b775018884, type: 3}
  player: {fileID: 1997553763}
  isVictoryDialogue: 0
