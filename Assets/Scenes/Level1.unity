  m_Script: {fileID: 11500000, guid: 8d5f919a06554c24581b88551cb58fc1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::BossDialogue
  canvasGroup: {fileID: 1837726012}
  dialogueText: {fileID: 1136835131}
  dialogueLines:
  - '"To think... that such a tiny creature could hold the power of the tides so
    firmly..."'
  - '"You have proven your worth, Wooper. My flame dims, but the sky remains vast."'
  - '"Go now... descend into the Sunless Caverns. Deep within the crystal veins,
    Lugia awaits."'
  - '"The crushing weight of the earth is far more unforgiving than my heat. Do not
    let your light go out!"'
  boss: {fileID: 0}
  player: {fileID: 1704766782}
  isVictoryDialogue: 1
