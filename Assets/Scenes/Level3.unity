  m_Script: {fileID: 11500000, guid: 8d5f919a06554c24581b88551cb58fc1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::BossDialogue
  canvasGroup: {fileID: 342775939}
  dialogueText: {fileID: 143617945}
  dialogueLines:
  - '"You have ascended far above the marshes, Quagsire. Do you not realize where
    you stand?"'
  - '"This is the High Reach... the domain of the Dragon King. The air here is too
    thin for the likes of you."'
  - '"I have watched your clumsy progress from the stars. You carry a strange strength
    behind that vacant gaze."'
  - '"But even the strongest earth-dweller must eventually fall back to the ground."'
  - '"I shall provide the gravity you require."'
  - '"Witness the fury of the gale! Prepare to be cast down!"'
  boss: {fileID: 5891784189549478663, guid: 0af76ca6b6bd6014ba2aa4f539678e21, type: 3}
  player: {fileID: 1836384289815454352}
  isVictoryDialogue: 0
