  canvasGroup: {fileID: 302253321}
  dialogueText: {fileID: 1498917911}
  dialogueLines:
  - '"Impossible... a dweller of the marshes has reached the peak of the heavens?"'
  - '"You have quelled the Dragon of the Skies with a strength that defies the natural
    order."'
  - '"The ozone layer is silent once more... the storm you brought has finally passed."'
  - '"Go back to your world, Quagsire. You have earned your place among the stars."'
  boss: {fileID: 0}
  player: {fileID: 1836384289815454352}
